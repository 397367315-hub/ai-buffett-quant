# 数据库
DATABASE_URL=postgresql+asyncpg://user:stockflow123@localhost:5432/stockflow

# Redis
REDIS_URL=redis://localhost:6379/0

# DeepSeek AI
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 应用
APP_ENV=development
DATA_REFRESH_INTERVAL=60

# 国内行情代理（部署在国内节点后填入；不填则后端直连数据源）
DATA_PROXY_BASE_URL=
DATA_PROXY_TOKEN=
DATA_PROXY_TIMEOUT=20

# FTShare MCP fallback: only used when the configured domestic source fails
FTSHARE_MCP_ENABLED=false
FTSHARE_MCP_URL=https://market.ft.tech/gateway/mcp
FTSHARE_MCP_TIMEOUT=10
FTSHARE_MCP_PROXY_TIMEOUT=12

# NumCat/MeoZ market data and optional Level-2 radar. Keep the key on the backend only.
LEVEL2_ENABLED=true
# Preferred production variables.
MEOZ_ENABLED=true
MEOZ_API_KEY=
MEOZ_API_ROUTE=dedicated
# Backwards-compatible credential alias.
NUMCAT_API_KEY=
NUMCAT_API_BASE=https://numcat.net/api
NUMCAT_ROUTE=dedicated
NUMCAT_SZ_BASE_URL=http://sz.numcat.net:8866/api
NUMCAT_SH_BASE_URL=http://sh.numcat.net:8866/api
NUMCAT_PUBLIC_BASE_URL=https://numcat.net/api
NUMCAT_ALLOW_PUBLIC_FALLBACK=false
NUMCAT_GLOBAL_QPS=50
NUMCAT_GLOBAL_RPM=500
NUMCAT_HEAVY_QPS=5
NUMCAT_CACHE_MAX_ENTRIES=512
NUMCAT_CACHE_MAX_BYTES=16777216
NUMCAT_CACHE_MAX_PAYLOAD_BYTES=2097152
NUMCAT_TIMEOUT=20
NUMCAT_RETRY_COUNT=3
NUMCAT_MIN_REQUEST_INTERVAL=0.25
LEVEL2_PAGE_SIZE=5000
LEVEL2_MAX_PAGES=200
LEVEL2_MAX_ROWS=500000
LEVEL2_CACHE_SECONDS=300

# OpenClaw stateless MCP gateway. Set a long random key in production.
OPENCLAW_ENABLED=false
OPENCLAW_API_KEY=
OPENCLAW_TOOL_TIMEOUT=45

# 可视化量化策略（不填时使用 backend/quant/data）
# Render 如挂载持久化磁盘，应设置为磁盘目录，例如 /var/data/quant
QUANT_DATA_DIR=
QUANT_SCAN_CACHE_SECONDS=300
QUANT_SCAN_MAX_TECHNICAL_STOCKS=1500
QUANT_BACKTEST_MAX_STOCKS=120

# 前端
NEXT_PUBLIC_API_URL=http://localhost:8000
